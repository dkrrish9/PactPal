# ==============================================================================
# PactPal: Zero-Trust Multimodal Escrow Referee for Digital Freelancing
# Environment Configuration Template
# ==============================================================================
# Copy this file to .env and replace placeholder values with your real configuration.
# DO NOT COMMIT YOUR ACTUAL .env FILE!
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. CORE API & DATABASE (Subsystem: Core-API / Backend)
# ------------------------------------------------------------------------------
NODE_ENV=development
PORT=8000
HOST=0.0.0.0
APP_SECRET=replace_with_a_secure_random_32_char_string
JWT_SECRET=replace_with_jwt_secret_key
SESSION_SECRET=replace_with_session_secret_key

# Hosted Relational Database (PostgreSQL / Supabase)
DATABASE_URL=postgresql://pactpal_user:pactpal_password@localhost:5432/pactpal_db
DB_SSL_ENABLED=false

# CORS & Network Origins
FRONTEND_URL=http://localhost:3000
BACKEND_URL=http://localhost:8000

# ------------------------------------------------------------------------------
# 2. PAYMENTS & ESCROW RAILS (Subsystem: Payments - PayPal)
# ------------------------------------------------------------------------------
# PayPal Orders API (Authorize, Capture, Payouts, Void/Refund)
PAYPAL_MODE=sandbox
PAYPAL_CLIENT_ID=your_paypal_sandbox_client_id
PAYPAL_CLIENT_SECRET=your_paypal_sandbox_client_secret
PAYPAL_API_BASE_URL=https://api-m.sandbox.paypal.com
PAYPAL_WEBHOOK_ID=your_paypal_webhook_id
PAYPAL_CURRENCY=USD

# Escrow Hold Expiration Safety Window (Days, default PayPal limit is 29 days)
PAYPAL_HOLD_DURATION_DAYS=29

# ------------------------------------------------------------------------------
# 3. AI REFEREE & MULTIMODAL AGENTS (Subsystem: Agents)
# ------------------------------------------------------------------------------
# Default provider: gemini | openai | anthropic
AI_PROVIDER=gemini

# Google Gemini API (Agreement Reader, Cheat Scanner, Referee Decision Engine)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL_TEXT=gemini-2.5-pro
GEMINI_MODEL_VISION=gemini-2.5-pro

# OpenAI API (Alternative / Fallback)
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL_TEXT=gpt-4o

# AI Referee Configuration
REFEREE_AUTO_RELEASE_THRESHOLD=0.95
REFEREE_PARTIAL_RELEASE_DEFAULT_PERCENT=0.80
MAX_RESUBMISSION_ATTEMPTS=3

# ------------------------------------------------------------------------------
# 4. VERIFICATION PIPELINE & SPONSOR TOOLS (Subsystem: Verification)
# ------------------------------------------------------------------------------
# Render Workflows (Isolated Verification Container Runner)
RENDER_API_KEY=your_render_api_key
RENDER_WORKFLOW_SERVICE_ID=your_render_workflow_service_id
RENDER_WORKFLOW_WORKSPACE=isolated_worker

# Figma API (Visual Ground Truth comparison for Stage E)
FIGMA_ACCESS_TOKEN=your_figma_personal_access_token
FIGMA_SAMPLE_FILE_KEY=your_sample_figma_file_key

# Visual Diff Settings
VISUAL_DIFF_SIMILARITY_THRESHOLD=0.85

# Proof-of-Work Receipts Fingerprint
RECEIPT_HASH_ALGORITHM=sha256
RECEIPT_SALT=replace_with_tamper_proof_secret_salt

# ------------------------------------------------------------------------------
# 5. FRONTEND & GANTT VISUALIZATION (Subsystem: Frontend)
# ------------------------------------------------------------------------------
# Bryntum Gantt / Scheduler (Trial or Sponsor Key)
BRYNTUM_LICENSE_KEY=your_bryntum_license_key_if_applicable
VITE_API_URL=http://localhost:8000/api/v1
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1

